{
  "expo": {
    "name": "Hindu Mantra Jap Counter",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "mobile",
    "userInterfaceStyle": "light",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#fff8eb"
    },
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "package": "com.dearasyouwish.mantrajap"
    },
    "web": {},
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
